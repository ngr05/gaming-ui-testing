{
    "name": "gaming-playwright-ui-tests",
    "version": "0.0.1",
    "description": "Gaming UI tests using Playwright",
    "scripts": {
        "check": "prettier . --check",
        "check:fix": "prettier . --write",
        "lint": "eslint .",
        "lint:fix": "npm run lint -- --fix",
        "format": "npm run check:fix && npm run lint:fix",
        "test": "playwright test",
        "test:debug": "playwright test --debug",
        "test:dry": "saucectl run --dry-run",
        "test:sauce": "saucectl run",
        "test:ui": "playwright test --ui",
        "test:precommit": "concurrently \"npm run test:bingo\" \"npm run test:casino\" \"npm run test:vegas\"",
        "test:prod": "echo 'Running Bingo tests...' && npm run test:bingo:live && echo 'Running Casino tests...' && npm run test:casino:live && echo 'Running Vegas tests...' && npm run test:vegas:live",
        "test:preprod": "concurrently \"npm run test:bingo:preprod\" \"npm run test:casino:preprod\" \"npm run test:vegas:preprod\"",
        "test:bingo": "concurrently \"npm run test:bingo:test\" \"npm run test:bingo:staging\" \"npm run test:bingo:live\"",
        "test:bingo:test": "ENVIRONMENT=test2 PRODUCT=bingo npm test",
        "test:bingo:staging": "ENVIRONMENT=staging PRODUCT=bingo npm test",
        "test:bingo:live": "ENVIRONMENT=live PRODUCT=bingo npm test",
        "test:bingo:preprod": "concurrently \"npm run test:bingo:test\" \"npm run test:bingo:staging\"",
        "test:casino": "concurrently \"npm run test:casino:next\" \"npm run test:casino:live\"",
        "test:casino:next": "ENVIRONMENT=next PRODUCT=casino npm test",
        "test:casino:live": "ENVIRONMENT=live PRODUCT=casino npm test",
        "test:casino:preprod": "npm run test:casino:next",
        "test:vegas": "concurrently \"npm run test:vegas:test\" \"npm run test:vegas:staging\" \"npm run test:vegas:live\"",
        "test:vegas:test": "ENVIRONMENT=test2 PRODUCT=vegas npm test",
        "test:vegas:staging": "ENVIRONMENT=staging PRODUCT=vegas npm test",
        "test:vegas:live": "ENVIRONMENT=live PRODUCT=vegas npm test",
        "test:vegas:preprod": "concurrently \"npm run test:vegas:test\" \"npm run test:vegas:staging\"",
        "testrail:report": "./testrail-report.sh",
        "prepare": "husky install && playwright install"
    },
    "keywords": [],
    "author": "Nick Green <nicholas.green@flutteruki.com>",
    "license": "ISC",
    "devDependencies": {
        "@playwright/test": "^1.39.0",
        "@types/node": "^20.6.5",
        "@typescript-eslint/eslint-plugin": "^6.7.4",
        "@typescript-eslint/parser": "^6.7.4",
        "allure-playwright": "^2.9.2",
        "concurrently": "^8.2.1",
        "eslint": "^8.50.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-playwright": "^0.16.0",
        "husky": "^8.0.0",
        "prettier": "^3.0.3",
        "saucectl": "^0.161.1",
        "typescript": "^5.2.2"
    },
    "engines": {
        "node": ">=18.17.1"
    },
    "packageManager": "npm@9.8.0",
    "homepage": "https://github.com/ngr05/gaming-ui-testing#readme",
    "bugs": {
        "url": "https://github.com/ngr05/gaming-ui-testing/issues",
        "email": "nicholas.green@flutteruki.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ngr05/gaming-ui-testing.git"
    },
    "dependencies": {
        "commander": "^11.0.0",
        "playwright": "^1.40.0",
        "playwright-chromium": "^1.11.1",
        "playwright-firefox": "^1.11.1",
        "playwright-webkit": "^1.11.1",
        "ts-node": "^10.9.1"
    },
    "bin": {
        "gput": "gput.ts"
    },
    "main": "gput.ts"
}
